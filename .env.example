# Copy to .env and fill in. Used by the CLI (`freestyle-volumes --env-file .env ...`),
# the examples and the live Freestyle tests. Real environment variables win over this file.

# Freestyle API key: needed to attach, inspect and detach on Freestyle VMs and to build snapshots.
FREESTYLE_API_KEY=

# S3-compatible storage that holds the volumes. The bucket must already exist.
VOLUMES_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
VOLUMES_S3_REGION=auto
VOLUMES_S3_BUCKET=my-volumes
VOLUMES_S3_PREFIX=freestyle-volumes
VOLUMES_S3_ACCESS_KEY_ID=
VOLUMES_S3_SECRET_ACCESS_KEY=
VOLUMES_S3_FORCE_PATH_STYLE=true
# Optional: rclone provider hint (AWS, Cloudflare, Minio, Ceph, Other), the endpoint as seen
# from inside the VM when it differs, and a session token for temporary credentials.
# VOLUMES_S3_PROVIDER=Cloudflare
# VOLUMES_S3_SANDBOX_ENDPOINT=
# VOLUMES_S3_SESSION_TOKEN=

# Optional: narrower keys for rclone inside each VM (for example limited to this namespace's
# prefix), instead of the keys above, which then stay on your machine.
# VOLUMES_S3_SANDBOX_ACCESS_KEY_ID=
# VOLUMES_S3_SANDBOX_SECRET_ACCESS_KEY=
# VOLUMES_S3_SANDBOX_SESSION_TOKEN=

# Optional: server-side encryption (AES256 or aws:kms, with a KMS key) and a storage class for
# volume data, for buckets whose policy requires them. Leave unset on Cloudflare R2.
# VOLUMES_S3_SSE=aws:kms
# VOLUMES_S3_SSE_KMS_KEY_ID=
# VOLUMES_S3_STORAGE_CLASS=STANDARD_IA

# Optional: boot the examples from a snapshot built with `freestyle-volumes prepare-snapshot`.
# VOLUMES_VM_SNAPSHOT=ubuntu-sm-volumes
