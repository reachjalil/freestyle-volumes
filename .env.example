# Freestyle API key (only needed for the live Freestyle tests and examples)
FREESTYLE_API_KEY=
# S3-compatible storage used for volumes
VOLUMES_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
VOLUMES_S3_REGION=auto
VOLUMES_S3_BUCKET=my-volumes
VOLUMES_S3_PREFIX=freestyle-volumes
VOLUMES_S3_ACCESS_KEY_ID=
VOLUMES_S3_SECRET_ACCESS_KEY=
VOLUMES_S3_FORCE_PATH_STYLE=true
