{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "freestyle-volumes": ["src/index.ts"],
      "freestyle-volumes/freestyle": ["src/freestyle.ts"],
      "freestyle-volumes/docker": ["src/docker.ts"],
      "freestyle-volumes/git": ["src/git.ts"]
    }
  },
  "include": ["examples/*.ts"]
}
